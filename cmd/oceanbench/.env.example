# OceanBench environment configuration.
# Copy this file to .env and adjust values as needed.
# .env is gitignored and will not be committed.

# OAuth2 callback URL for local development.
OAUTH2_CALLBACK=http://localhost:8080/oauth2callback

# Port to listen on (default: 8080).
# PORT=8080

# YouTube API secrets file path
YOUTUBE_SECRETS=/Users/coralfisher/.config/YouTube-secrets.json

# Google Application Credentials file path
# This should point to a GCP service account JSON key file that has access to Datastore
# (e.g., cloud-datastore-user@ausocean.iam.gserviceaccount.com).
GOOGLE_APPLICATION_CREDENTIALS=/Users/coralfisher/.config/AusOcean-ef9cd79f81a8.json

# Vidgrind Credentials file path
VIDGRIND_CREDENTIALS=/Users/coralfisher/.config/VideoGrinder-b0ad82abac05.json

# OceanBench secrets file path
OCEANBENCH_SECRETS=/Users/coralfisher/.config/OceanBench-secrets.txt

# OceanCron secrets file path
OCEANCRON_SECRETS=/Users/coralfisher/.config/OceanCron-secrets.txt
